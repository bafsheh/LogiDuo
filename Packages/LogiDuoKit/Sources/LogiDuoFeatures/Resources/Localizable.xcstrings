    "recovery.plan.explanation": {
      "comment": "Explains the emergency reset.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency reset returns only the buttons LogiDuo can take over to their normal behavior. It does not touch the primary or secondary buttons, stored device settings, other controls, or remappings, and it is not a factory reset. Each button is checked afterwards. If another app such as Logi Options+ is running, it may need to reapply its settings."
          }
        }
      }
    },
    "recovery.plan.header %@": {
      "comment": "Header of the emergency reset plan; argument is the device name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency Reset: %@"
          }
        }
      }
    },
    "recovery.plan.journalCorrupted": {
      "comment": "Plan note when records were unreadable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery records were unreadable, so this plan is based only on what the device reports now."
          }
        }
      }
    },
