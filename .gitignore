# --- Documentation policy -------------------------------------------------
# README.md at the repository root is the only Markdown file that may be
# tracked. scripts/check-repo-hygiene.sh enforces this for tracked files too.
*.md
*.markdown
!/README.md

# --- Local editor / agent working directories (never publish) -------------
.cursor/
.claude/
.codex/
.continue/
.windsurf/
.agents/
.aider/
.aider*
.specstory/
.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
GEMINI.md
.cursorrules
.cursorignore
.mcp.json
mcp.json
skills-lock.json
**/skills-lock.json

# --- Xcode / SwiftPM build output ----------------------------------------
.build/
build/
DerivedData/
*.xcresult
*.xcarchive
*.dSYM
*.dSYM.zip
*.ipa
*.app
*.dmg
*.pkg
xcuserdata/
*.xcuserstate
*.xcscmblueprint
.swiftpm/xcode/xcuserdata/
.swiftpm/configuration/registries.json
Packages/*/.swiftpm/

# --- Signing material and secrets ----------------------------------------
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.p8
*.pem
*.key
.env
.env.*
*.local.json
*.local.xcconfig

# --- Diagnostics that may contain device identifiers ---------------------
*.hidcapture
*.log
*.trace

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
